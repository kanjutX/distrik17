# Environment Variables untuk Vercel
# Vercel Postgres otomatis inject variabel berikut saat di-link:
POSTGRES_URL="postgres://default:xxx@ep-xxx.us-east-1.postgres.vercel-storage.com:5432/verceldb"
POSTGRES_PRISMA_URL="postgres://default:xxx@ep-xxx.us-east-1.postgres.vercel-storage.com:5432/verceldb?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgres://default:xxx@ep-xxx.us-east-1.postgres.vercel-storage.com:5432/verceldb"

# Auth — isi dengan string acak panjang di Vercel, jangan dibiarkan default
JWT_SECRET="ganti-dengan-string-rahasia-acak-minimal-32-karakter"

# Public App Info
VITE_APP_TITLE="Distrik 17 - Roblox Development Hub"
VITE_ROBLOX_GAME_ID="123456789"
VITE_DISCORD_INVITE="https://discord.gg/distrik17"
